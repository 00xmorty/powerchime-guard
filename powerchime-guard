#!/usr/bin/env python3
"""Read-only PowerChime preference and power-source inspector."""

import argparse
import json
import platform
import subprocess
import sys
from pathlib import Path

VERSION = "0.2.0"
DOMAIN = "com.apple.PowerChime"
KEY = "ChimeOnAllHardware"
APP = Path("/System/Library/CoreServices/PowerChime.app")


def run(command):
    try:
        return subprocess.run(
            command, capture_output=True, text=True, timeout=3, check=False
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        return type("Result", (), {"returncode": 2, "stdout": "", "stderr": str(error)})()


def normalize_preference(value):
    if value is None:
        return "default"
    if isinstance(value, bool):
        return "enabled" if value else "disabled"
    text = str(value).strip().lower()
    if text in {"1", "true", "yes", "enabled"}:
        return "enabled"
    if text in {"0", "false", "no", "disabled"}:
        return "disabled"
    if text == "default":
        return "default"
    raise ValueError("preference must be default, enabled, disabled, true, or false")


def inspect_live():
    if platform.system() != "Darwin":
        raise RuntimeError("live inspection requires macOS; use --input for offline tests")

    pref = run(["defaults", "read", DOMAIN, KEY])
    if pref.returncode == 0:
        preference = normalize_preference(pref.stdout)
    elif "does not exist" in pref.stderr or "not found" in pref.stderr.lower():
        preference = "default"
    else:
        raise RuntimeError("defaults query failed: " + pref.stderr.strip())

    power = run(["pmset", "-g", "ps"])
    if power.returncode != 0:
        raise RuntimeError("pmset query failed: " + power.stderr.strip())
    first_line = power.stdout.splitlines()[0] if power.stdout.splitlines() else "unknown"
    source = first_line.split("'")[1] if "'" in first_line else first_line.strip()

    return {
        "platform": "Darwin",
        "preference": preference,
        "power_source": source,
        "powerchime_present": APP.exists(),
    }


def inspect_fixture(path):
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"invalid input: {error}") from error
    required = {"platform", "preference", "power_source", "powerchime_present"}
    if not required.issubset(data):
        raise ValueError("input requires platform, preference, power_source, powerchime_present")
    if not isinstance(data["powerchime_present"], bool):
        raise ValueError("powerchime_present must be boolean")
    if data["platform"] != "Darwin" or not isinstance(data["power_source"], str):
        raise ValueError("input requires Darwin platform and string power_source")
    data["preference"] = normalize_preference(data["preference"])
    return data

def power_class(source):
    source = source.strip().lower()
    if source in {"ac power", "ac", "external power"}:
        return "AC"
    if source in {"battery power", "battery"}:
        return "battery"
    return "unknown"


def compare_power(before, after):
    old, new = power_class(before["power_source"]), power_class(after["power_source"])
    return {"before": old, "after": new,
            "transition": "unknown" if "unknown" in (old, new) else
            ("changed" if old != new else "stable"),
            "preference_changed": before["preference"] != after["preference"]}


def findings(data):
    items = []
    if not data["powerchime_present"]:
        items.append("PowerChime app was not found; this macOS version may use another mechanism.")
    if data["preference"] == "disabled":
        items.append("The user preference requests that charging chimes stay off.")
    elif data["preference"] == "enabled":
        items.append("The user preference explicitly allows charging chimes.")
    else:
        items.append("No user override is stored; macOS controls the default behavior.")
    if power_class(data["power_source"]) == "AC":
        items.append("AC power is connected now; this snapshot cannot detect earlier reconnects.")
    elif power_class(data["power_source"]) == "battery":
        items.append("AC power is not reported now; inspect the cable, dock, and port if it cycles.")
    else:
        items.append("Power source is unknown; do not infer a disconnection from this snapshot.")
    items.append("Repeated chimes can indicate power negotiation or a loose cable; muting is not a repair.")
    return items


def plan(mode):
    if mode == "disable":
        return [f"defaults write {DOMAIN} {KEY} -bool false"]
    return [f"defaults delete {DOMAIN} {KEY}"]


def parse_args():
    parser = argparse.ArgumentParser(
        description="Inspect the macOS charging-chime preference without changing it."
    )
    parser.add_argument("--input", metavar="FILE", help="read a JSON fixture instead of live state")
    parser.add_argument("--compare", metavar="FILE", help="compare a second offline snapshot (requires --input)")
    parser.add_argument("--json", action="store_true", help="print machine-readable output")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--plan-disable", action="store_true", help="print a disable command only")
    group.add_argument("--plan-restore", action="store_true", help="print a restore command only")
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    return parser.parse_args()


def main():
    args = parse_args()
    if args.compare and not args.input:
        print("ERROR: --compare requires --input", file=sys.stderr)
        return 2
    try:
        data = inspect_fixture(args.input) if args.input else inspect_live()
        second = inspect_fixture(args.compare) if args.compare else None
    except (RuntimeError, ValueError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 2

    result = {**data, "findings": findings(data), "changed": False}
    if second is not None:
        result["comparison"] = compare_power(data, second)
    mode = "disable" if args.plan_disable else "restore" if args.plan_restore else None
    if mode:
        result["plan"] = plan(mode)

    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0

    print("PowerChime Guard — read-only charging-chime inspector")
    print(f"Preference: {data['preference']}")
    print(f"Power source: {data['power_source']}")
    print(f"PowerChime app: {'present' if data['powerchime_present'] else 'not found'}")
    for item in result["findings"]:
        print(f"- {item}")
    if second is not None:
        comparison = result["comparison"]
        print(f"Comparison: {comparison['before']} -> {comparison['after']} ({comparison['transition']})")
        print("LIMIT: two snapshots do not prove why a chime sounded or establish cable health.")
    if mode:
        print("PLAN ONLY — review and run manually; this tool changed nothing:")
        for command in result["plan"]:
            print(command)
    print("LIMIT: one snapshot cannot prove why a chime repeated or certify a cable/dock.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
